#################################### PostgreSQL ###################################
POSTGRES_CONTAINER_NAME=extratech-postgres
POSTGRES_VERSION=18
POSTGRES_DB=extratech
POSTGRES_USER=et-user
POSTGRES_PASSWORD=<defina_uma_senha_segura>
POSTGRES_PORT=5432
POSTGRES_DATA_DIR=/var/opt/extratech/data/db
POSTGRES_HOST=192.168.15.100
# Timezone
TZ=America/Sao_Paulo
PGTZ=America/Sao_Paulo

SERVER_PORT=8081
#################################### Back-end ###################################
SERVER_PORT=8081
BACKEND_HOST=localhost

#################################### E-mail (Mailtrap) ###################################
# log  = código aparece só no console do back-end
# smtp = envia o e-mail de verdade (dados do Mailtrap abaixo)
EMAIL_MODO=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=9724febf35c348
MAIL_PASSWORD=0df0a33becfd8d
MAIL_REMETENTE=nao-responda@extratechrestre.com.br
