#################################### PostgreSQL ###################################
POSTGRES_CONTAINER_NAME=extratech-postgres
POSTGRES_VERSION=18
POSTGRES_DB=extratech
POSTGRES_USER=<definir_um_nome_de_usuario>
POSTGRES_PASSWORD=<defina_uma_senha_segura>
POSTGRES_PORT=5432
POSTGRES_DATA_DIR=/var/opt/extratech/data/db
POSTGRES_HOST=<definir_o_endereco_do_host> # Exemplo:  localhost
# Timezone
TZ=America/Sao_Paulo
PGTZ=America/Sao_Paulo

#################################### Back-end ###################################
SERVER_PORT=8081
BACKEND_HOST=<definir_o_endereco_do_host> #Exemplo: localhost

#################################### E-mail (Mailtrap) ###################################
# log  = código aparece só no console do back-end
# smtp = envia o e-mail de verdade (dados do Mailtrap abaixo)
EMAIL_MODO=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=<definir_email_username>
MAIL_PASSWORD=<definir_email_password>
MAIL_REMETENTE=<definir_email_remetente>                            # Exemplo: nao-responda@extratechrestre.com.br
